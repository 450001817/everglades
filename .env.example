# Copy this file to .env and fill in the values. .env is private: it is never uploaded to GitHub
# (see .gitignore) and is left out of Everglades-WebGame.zip. On Render, set the same names under Environment.

# Upstash Redis: keeps player accounts and Eco-bucks safe across restarts (see README).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google sign-in (optional; see README "Turning on Sign in with Google").
GOOGLE_CLIENT_ID=
